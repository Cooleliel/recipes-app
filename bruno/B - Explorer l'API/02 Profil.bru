meta {
  name: B2 - Profil de l'utilisateur connecté
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/v1/user
  body: none
  auth: none
}

headers {
  apikey: {{supabaseKey}}
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Statut 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("C'est bien mon utilisateur", function() {
    expect(res.getBody().email).to.equal(bru.getEnvVar("email"));
  });
}

docs {
  Écran Profil. Route protégée : sans token valide, erreur 401.
}
